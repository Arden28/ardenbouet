generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id        Int      @id @default(1)
  data      Json
  updatedAt DateTime @updatedAt
}
model Message {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  // sender
  name       String
  email      String

  // project details
  services   String?   // CSV
  timeframe  String?
  budget     Int?      // 1..5
  body       String

  // meta
  ip         String?
  userAgent  String?
  read       Boolean   @default(false)
  archived   Boolean   @default(false)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

