generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id        Int      @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Message {
  id         Int      @id @default(autoincrement())
  createdAt  DateTime @default(now())

  name       String
  email      String

  services   String[]
  timeframe  String?
  budget     Budget?
  body       String

  ip         String?
  userAgent  String?
  read       Boolean   @default(false)
  archived   Boolean   @default(false)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([read, createdAt])
}

enum Budget {
  LOW
  MEDIUM
  HIGH
  PREMIUM
  ENTERPRISE
}

model Order {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  customerName  String
  customerEmail String
  productId     String
  productTitle  String

  status        OrderStatus @default(PENDING)
  amount        Float
  currency      String      @default("USD")

  stripeId        String?
  paymentRef      String?
  paymentProvider String?
  notes           String?

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model DownloadToken {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  productTitle  String
  customerEmail String
  customerName  String
  fileUrl       String
  expiresAt     DateTime
  downloadCount Int      @default(0)
  maxDownloads  Int      @default(3)
  createdAt     DateTime @default(now())

  @@index([orderId])
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

enum CrmClientStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum CrmProjectStatus {
  DISCOVERY
  PROPOSAL
  ACTIVE
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum CrmInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model CrmClient {
  id        String          @id @default(cuid())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  name      String
  company   String?
  email     String
  phone     String?
  country   String?
  status    CrmClientStatus @default(LEAD)
  notes     String?
  tags      String[]        @default([])

  projects  CrmProject[]
  invoices  CrmInvoice[]

  @@index([email])
  @@index([status, createdAt])
}

model CrmProject {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  title       String
  description String?
  status      CrmProjectStatus @default(DISCOVERY)
  budget      Float?
  currency    String           @default("USD")
  startDate   DateTime?
  endDate     DateTime?
  notes       String[]         @default([])

  clientId    String
  client      CrmClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices    CrmInvoice[]

  @@index([clientId])
  @@index([status, createdAt])
}

model CrmInvoice {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  invoiceNumber String           @unique
  amount        Float
  currency      String           @default("USD")
  status        CrmInvoiceStatus @default(DRAFT)
  issuedAt      DateTime         @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?

  clientId      String
  client        CrmClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId     String?
  project       CrmProject?      @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status, issuedAt])
}