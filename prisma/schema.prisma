generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Content {
  id        Int      @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Message {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  name  String
  email String

  services  String[]
  timeframe String?
  budget    Budget?
  body      String

  ip        String?
  userAgent String?
  read      Boolean @default(false)
  archived  Boolean @default(false)

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([read, createdAt])
}

enum Budget {
  LOW
  MEDIUM
  HIGH
  PREMIUM
  ENTERPRISE
}

model Order {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customerName  String
  customerEmail String
  productId     String
  productTitle  String

  status   OrderStatus @default(PENDING)
  amount   Float
  currency String      @default("USD")

  stripeId        String?
  paymentRef      String?
  paymentProvider String?
  notes           String?

  @@index([customerEmail, createdAt])
  @@index([status, createdAt])
  @@index([productId])
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

model DownloadToken {
  id            String   @id @default(cuid())
  orderId       String
  productId     String
  productTitle  String
  customerEmail String
  customerName  String
  fileUrl       String
  expiresAt     DateTime
  downloadCount Int      @default(0)
  maxDownloads  Int      @default(3)
  createdAt     DateTime @default(now())

  @@index([orderId])
}

// ─── CRM ──────────────────────────────────────────────────────────────────────

enum CrmClientStatus {
  LEAD
  ACTIVE
  INACTIVE
}

enum CrmProjectStatus {
  DISCOVERY
  PROPOSAL
  ACTIVE
  REVIEW
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum CrmInvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model CrmClient {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name    String
  company String?
  email   String
  phone   String?
  country String?
  status  CrmClientStatus @default(LEAD)
  notes   String?
  tags    String[]        @default([])

  projects CrmProject[]
  invoices CrmInvoice[]

  @@index([email])
  @@index([status, createdAt])
}

model CrmProject {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title       String
  description String?
  status      CrmProjectStatus @default(DISCOVERY)
  budget      Float?
  currency    String           @default("USD")
  startDate   DateTime?
  endDate     DateTime?
  notes       String[]         @default([])

  clientId String
  client   CrmClient    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  invoices CrmInvoice[]

  @@index([clientId])
  @@index([status, createdAt])
}

model CrmInvoice {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoiceNumber String           @unique
  amount        Float
  currency      String           @default("USD")
  status        CrmInvoiceStatus @default(DRAFT)
  issuedAt      DateTime         @default(now())
  dueAt         DateTime?
  paidAt        DateTime?
  notes         String?

  clientId  String
  client    CrmClient   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId String?
  project   CrmProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([projectId])
  @@index([status, issuedAt])
}

// ─── Blog ─────────────────────────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  REVIEW // submitted by a writer whose grant can't publish directly
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum CommentStatus {
  VISIBLE
  HIDDEN
  DELETED
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

model Post {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slug         String  @unique
  title        String  @default("")
  subtitle     String  @default("")
  excerpt      String  @default("")
  coverUrl     String?
  coverAlt     String?
  coverCaption String?

  // Body: TipTap/ProseMirror JSON. Posts migrated from the old Content.notes keep
  // their markdown in bodyMd until first saved in the new editor (content then wins).
  content Json?
  bodyMd  String?

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?

  tags           String[] @default([])
  language       String   @default("en")
  readingMinutes Int      @default(1)
  wordCount      Int      @default(0)
  featured       Boolean  @default(false)
  commentsOpen   Boolean  @default(true)

  seoTitle       String?
  seoDescription String?
  canonicalUrl   String?

  views            Int       @default(0)
  newsletterSentAt DateTime?
  legacyNoteId     String?   @unique

  seriesId    String?
  series      Series? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  seriesOrder Int     @default(0)

  // null author = the site owner (Arden). Writers are Readers with a WriterGrant.
  authorId         String?
  author           Reader? @relation("AuthoredPosts", fields: [authorId], references: [id], onDelete: SetNull)
  donationsEnabled Boolean @default(false)

  // EN/FR versions of the same story point at the original.
  translationOfId String?
  translationOf   Post?   @relation("Translations", fields: [translationOfId], references: [id], onDelete: SetNull)
  translations    Post[]  @relation("Translations")

  comments   Comment[]
  claps      Clap[]
  highlights Highlight[]
  bookmarks  Bookmark[]
  revisions  PostRevision[]
  donations  Donation[]

  @@index([authorId, status])
  @@index([translationOfId])
  @@index([status, publishedAt])
  @@index([seriesId, seriesOrder])
}

model PostRevision {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  label     String   @default("")
  title     String
  subtitle  String   @default("")
  content   Json?
  bodyMd    String?

  @@index([postId, createdAt])
}

model Series {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  slug        String   @unique
  title       String
  description String   @default("")
  coverUrl    String?
  posts       Post[]
}

/// A blog reader signed in through next-auth (Google / GitHub). Not an admin.
model Reader {
  id                String   @id @default(cuid())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  provider          String
  providerAccountId String
  name              String
  email             String?
  image             String?
  banned            Boolean  @default(false)

  // Public profile (/blog/@handle)
  handle     String?   @unique
  bio        String    @default("")
  website    String?
  location   String?
  locale     String    @default("en")
  lastSeenAt DateTime?

  // Writer payouts (Stripe Connect Express)
  stripeAccountId      String? @unique
  stripeChargesEnabled Boolean @default(false)
  stripePayoutsEnabled Boolean @default(false)

  comments          Comment[]
  commentLikes      CommentLike[]
  highlights        Highlight[]
  bookmarks         Bookmark[]
  posts             Post[]          @relation("AuthoredPosts")
  writerGrant       WriterGrant?
  writerRequests    WriterRequest[]
  invitesUsed       WriterInvite[]
  donationsReceived Donation[]      @relation("DonationRecipient")
  donationsMade     Donation[]      @relation("DonationDonor")

  @@unique([provider, providerAccountId])
}

// ─── Writers ──────────────────────────────────────────────────────────────────

enum GrantScope {
  UNLIMITED // write as many stories as they like
  LIMITED // up to maxPosts stories of their own
  SPECIFIC // only edit the stories listed in postIds
}

/// Writing permission for a reader. One per reader; revoked grants keep their row.
model WriterGrant {
  id         String     @id @default(cuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  readerId   String     @unique
  reader     Reader     @relation(fields: [readerId], references: [id], onDelete: Cascade)
  scope      GrantScope @default(UNLIMITED)
  maxPosts   Int?
  postIds    String[]   @default([])
  canPublish Boolean    @default(true) // false = stories go to REVIEW
  expiresAt  DateTime?
  revokedAt  DateTime?
  note       String     @default("")
}

model WriterInvite {
  id              String     @id @default(cuid())
  createdAt       DateTime   @default(now())
  token           String     @unique
  email           String?
  note            String     @default("")
  scope           GrantScope @default(UNLIMITED)
  maxPosts        Int?
  postIds         String[]   @default([])
  canPublish      Boolean    @default(true)
  grantExpiresAt  DateTime?
  inviteExpiresAt DateTime?
  acceptedAt      DateTime?
  acceptedById    String?
  acceptedBy      Reader?    @relation(fields: [acceptedById], references: [id], onDelete: SetNull)
  revokedAt       DateTime?
}

enum WriterRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WriterRequest {
  id           String              @id @default(cuid())
  createdAt    DateTime            @default(now())
  readerId     String
  reader       Reader              @relation(fields: [readerId], references: [id], onDelete: Cascade)
  message      String
  sampleUrl    String?
  topics       String[]            @default([])
  status       WriterRequestStatus @default(PENDING)
  decidedAt    DateTime?
  decisionNote String              @default("")

  @@index([status, createdAt])
}

// ─── Donations (Stripe Connect) ───────────────────────────────────────────────

enum DonationStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Donation {
  id                    String         @id @default(cuid())
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  postId                String?
  post                  Post?          @relation(fields: [postId], references: [id], onDelete: SetNull)
  // null recipient = the site owner (paid to the platform account)
  recipientId           String?
  recipient             Reader?        @relation("DonationRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  donorId               String?
  donor                 Reader?        @relation("DonationDonor", fields: [donorId], references: [id], onDelete: SetNull)
  donorName             String         @default("")
  donorEmail            String?
  message               String         @default("")
  isPublic              Boolean        @default(true)
  amount                Int // minor units (cents)
  currency              String         @default("usd")
  feeAmount             Int            @default(0)
  status                DonationStatus @default(PENDING)
  stripePaymentIntentId String         @unique

  @@index([recipientId, status])
  @@index([postId, status])
}

// ─── Bookings (Google Calendar) ───────────────────────────────────────────────

enum MeetingLocation {
  GOOGLE_MEET
  CUSTOM_LINK
  PHONE
  IN_PERSON
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model MeetingType {
  id             String          @id @default(cuid())
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  slug           String          @unique
  title          String
  titleFr        String          @default("")
  description    String          @default("")
  descriptionFr  String          @default("")
  durationMin    Int             @default(30)
  bufferMin      Int             @default(10)
  location       MeetingLocation @default(GOOGLE_MEET)
  locationDetail String          @default("")
  active         Boolean         @default(true)
  sortOrder      Int             @default(0)
  bookings       Booking[]
}

/// Singleton (id = 1): weekly availability + Google Calendar connection.
model BookingConfig {
  id                 Int      @id @default(1)
  updatedAt          DateTime @updatedAt
  timezone           String   @default("Africa/Nairobi")
  // [{ day: 0-6 (Sun-Sat), start: "09:00", end: "17:00" }]
  rules              Json     @default("[]")
  minNoticeMin       Int      @default(240)
  maxDaysAhead       Int      @default(30)
  slotStepMin        Int      @default(30)
  googleRefreshToken String?
  googleEmail        String?
  googleCalendarId   String   @default("primary")
}

model Booking {
  id            String        @id @default(cuid())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  meetingTypeId String
  meetingType   MeetingType   @relation(fields: [meetingTypeId], references: [id], onDelete: Cascade)
  start         DateTime
  end           DateTime
  name          String
  email         String
  notes         String        @default("")
  guestTimezone String        @default("UTC")
  locale        String        @default("en")
  status        BookingStatus @default(CONFIRMED)
  googleEventId String?
  meetLink      String?
  cancelToken   String        @unique
  cancelledAt   DateTime?
  cancelReason  String        @default("")
  crmClientId   String?

  @@index([start, status])
}

model Comment {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  editedAt  DateTime?

  postId   String
  post     Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  // null readerId + isAuthor = written by the site owner from the admin
  readerId String?
  reader   Reader? @relation(fields: [readerId], references: [id], onDelete: Cascade)
  isAuthor Boolean @default(false)

  parentId String?
  parent   Comment?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Replies")

  body      String
  quote     String? // highlighted passage this comment responds to
  status    CommentStatus @default(VISIBLE)
  pinned    Boolean       @default(false)
  likeCount Int           @default(0)

  likes CommentLike[]

  @@index([postId, createdAt])
  @@index([parentId])
  @@index([status, createdAt])
}

model CommentLike {
  commentId String
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  readerId  String
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([commentId, readerId])
}

/// Medium-style claps: one row per (post, visitor), up to 50 claps each.
/// visitorKey is `r:<readerId>` for signed-in readers or `a:<uuid>` for anonymous visitors.
model Clap {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  postId     String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  visitorKey String
  count      Int      @default(0)

  @@unique([postId, visitorKey])
}

model Highlight {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  readerId  String
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  quote     String

  @@index([postId])
  @@index([readerId, createdAt])
}

model Bookmark {
  readerId  String
  reader    Reader   @relation(fields: [readerId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([readerId, postId])
}

model Subscriber {
  id          String           @id @default(cuid())
  createdAt   DateTime         @default(now())
  confirmedAt DateTime?
  email       String           @unique
  status      SubscriberStatus @default(PENDING)
  token       String           @unique
  source      String?
}
